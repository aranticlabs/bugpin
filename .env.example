# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.
# Every line is optional; the values shown are the defaults.

# Image tag for every BugPin image. Use an exact release such as 2.0.1, or a release line such as 2.0.
# BUGPIN_TAG=latest

# Scheme the browser uses: http or https. Set to https when TLS terminates at a reverse proxy in front of BugPin.
# BUGPIN_PUBLIC_SCHEME=http

# Comma-separated IP addresses or CIDRs of a reverse proxy in front of BugPin, so client
# addresses are preserved. CIDR prefixes must be at least /8 for IPv4 and /16 for IPv6.
# "private" trusts loopback and private networks; use it only when untrusted clients cannot
# reach port 7300 (or 7310 with the separate-portal profile) directly.
# BUGPIN_TRUSTED_PROXIES=

# DNS resolver the frontend containers use to find bugpin-server: an IPv4 address, or an IPv6
# address in brackets, with an optional port. 127.0.0.11 is Docker's DNS.
# BUGPIN_RESOLVER=127.0.0.11

# Private or VPN address for bugpin-server. Used only with deploy/docker-compose.server-private.yml.
# BUGPIN_SERVER_PRIVATE_IP=10.0.0.10
