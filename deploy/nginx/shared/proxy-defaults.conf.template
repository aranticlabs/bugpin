proxy_pass ${BUGPIN_SERVER_SCHEME}://bugpin_backend;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate "${BUGPIN_SERVER_CA_FILE}";
proxy_ssl_server_name on;
proxy_ssl_name ${BUGPIN_SERVER_HOST};
proxy_http_version 1.1;
proxy_set_header X-BugPin-Frontend $bugpin_frontend;
proxy_set_header Host $http_host;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Forwarded-Proto ${BUGPIN_PUBLIC_SCHEME};
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Forwarded "";
proxy_set_header X-BugPin-Proxy-Token "${BUGPIN_PROXY_TOKEN}";
proxy_connect_timeout 30s;
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;
proxy_request_buffering off;
