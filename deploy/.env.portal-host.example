# Copy to .env next to the portal host's Compose file.
# Do not commit the resulting .env: it contains the proxy token.

# Image tag. Use the same tag as the main BugPin host.
# BUGPIN_TAG=latest

# Address of bugpin-server on the main host, reachable over a private network or VPN.
BUGPIN_SERVER_URL=http://10.0.0.10:4300

# Proxy token from the Admin Console: Settings > Access > Network > Proxy token.
BUGPIN_PROXY_TOKEN=

# CA bundle used to verify the server certificate when BUGPIN_SERVER_URL uses https.
# BUGPIN_SERVER_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# IP addresses or CIDRs of the TLS reverse proxy in front of the portal. The default "private"
# is safe only while port 7310 is published to the local reverse proxy alone.
# BUGPIN_TRUSTED_PROXIES=private

# DNS resolver used to re-resolve BUGPIN_SERVER_URL.
# BUGPIN_RESOLVER=127.0.0.11
