{
  "name": "@arantic/bugpin-widget",
  "description": "Embeddable visual bug reporting widget - Capture screenshots, annotate issues, and submit bug reports",
  "version": "1.1.2",
  "license": "MIT",
  "type": "module",
  "main": "dist/widget.cjs.js",
  "module": "dist/widget.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/widget.esm.js",
      "require": "./dist/widget.cjs.js"
    },
    "./iife": "./dist/widget.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "bug-reporting",
    "feedback",
    "screenshot",
    "annotation",
    "widget",
    "issue-tracker",
    "visual-feedback",
    "bugpin",
    "self-hosted"
  ],
  "author": "Arantic Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/aranticlabs/bugpin.git",
    "directory": "src/widget"
  },
  "homepage": "https://bugpin.io",
  "bugs": {
    "url": "https://github.com/aranticlabs/bugpin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-preact": "^1.33.0",
    "preact": "^10.29.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.0.1",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  }
}
