{
  "name": "@bugpin/server",
  "description": "BugPin server - Bun + Hono backend",
  "version": "1.2.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch index.ts",
    "build": "bun build index.ts --outdir ../../dist/server --target bun",
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run storage/migrations/index.ts",
    "migrate-to-s3": "bun run scripts/migrate-to-s3.ts",
    "reset-password": "bun run scripts/reset-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "hono": "^4.13.3",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/nodemailer": "^8.0.1",
    "bun-types": "1.4.0",
    "typescript": "^7.0.2"
  }
}
