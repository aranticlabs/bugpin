{
  "name": "@bugpin/server",
  "description": "BugPin server - Bun + Hono backend",
  "version": "1.2.6",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch index.ts",
    "build": "bun build index.ts --outdir ../../dist/server --target bun",
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run storage/migrations/index.ts",
    "migrate-to-s3": "bun run scripts/migrate-to-s3.ts",
    "reset-password": "bun run scripts/reset-password.ts",
    "reset-two-factor": "bun run scripts/reset-two-factor.ts",
    "reset-portal-origin": "bun run scripts/reset-portal-origin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.16",
    "mediabunny": "1.64.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/nodemailer": "^8.0.2",
    "bun-types": "1.4.4",
    "typescript": "^7.0.2"
  }
}
