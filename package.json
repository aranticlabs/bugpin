{
  "name": "bugpin",
  "description": "Self-hosted visual bug reporting tool",
  "version": "1.3.0",
  "packageManager": "bun@1.4.4",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "workspaces": [
    "src/server",
    "src/admin",
    "src/widget",
    "src/shared-ui",
    "src/portal"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:admin & bun run dev:portal",
    "dev:server": "bun run --cwd src/server dev",
    "dev:admin": "bun run --cwd src/admin dev",
    "dev:widget": "bun run --cwd src/widget build:watch",
    "build": "bun run build:server && bun run build:admin && bun run build:widget && bun run build:portal",
    "build:server": "bun run --cwd src/server build",
    "build:admin": "bun run --cwd src/admin build",
    "build:widget": "bun run --cwd src/widget build",
    "check:widget-size": "bun run build:widget && bun run src/widget/scripts/check-bundle-size.ts",
    "start": "bun run src/server/index.ts",
    "typecheck": "bun run typecheck:server && bun run typecheck:shared-ui && bun run typecheck:admin && bun run typecheck:widget && bun run typecheck:ee && bun run typecheck:portal && bun run typecheck:e2e",
    "typecheck:server": "bun run --cwd src/server typecheck",
    "typecheck:shared-ui": "bun run --cwd src/shared-ui typecheck",
    "typecheck:admin": "bun run --cwd src/admin typecheck",
    "typecheck:widget": "bun run --cwd src/widget typecheck",
    "typecheck:ee": "bun run src/server/scripts/check-ee.ts typecheck",
    "test": "bun run test:server && bun run test:admin && bun run test:widget && bun run test:ee && bun run test:portal",
    "test:server": "bun test tests/server tests/shared",
    "test:admin": "bun run --cwd src/admin test",
    "test:widget": "bun run --cwd src/widget test",
    "test:ee": "bun run src/server/scripts/check-ee.ts test",
    "check:ee": "bun run src/server/scripts/check-ee.ts check",
    "migrate": "bun run --cwd src/server migrate",
    "repair-github-links": "bun run src/server/scripts/repair-github-links.ts",
    "reset-password": "bun run --cwd src/server reset-password",
    "reset-two-factor": "bun run --cwd src/server reset-two-factor",
    "reset-portal-origin": "bun run --cwd src/server reset-portal-origin",
    "knip": "knip",
    "format": "prettier --no-error-on-unmatched-pattern --ignore-path .prettierignore --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" \"docs-dev/**/*.{md,mdx}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --ignore-path .prettierignore --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" \"docs-dev/**/*.{md,mdx}\"",
    "check:dependency-age": "bun run src/server/scripts/check-dependency-age.ts bun.lock ee/bun.lock",
    "dev:portal": "bun run --cwd src/portal dev",
    "build:portal": "bun run --cwd src/portal build",
    "typecheck:portal": "bun run --cwd src/portal typecheck",
    "typecheck:tests": "tsc --project tests/server/tsconfig.json --noEmit",
    "test:portal": "bun run --cwd src/portal test",
    "test:e2e": "bun run build && bun build tests/e2e/server.ts --outdir dist/e2e --target bun && playwright test",
    "check:portal-bundle": "bun run build:portal",
    "typecheck:e2e": "tsc --project tests/e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "@playwright/test": "1.56.1"
  },
  "overrides": {
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.7.2",
    "tar": "^7.5.13",
    "dompurify": "^3.4.17",
    "smol-toml": "^1.9.0",
    "brace-expansion": "^2.0.3",
    "follow-redirects": "^1.16.1",
    "markdown-it": "^14.1.1",
    "postcss": "^8.5.13",
    "rollup": "^4.60.2",
    "minimatch": "^9.0.9",
    "picomatch": "^4.0.4",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.2",
    "zod": "^4.6.6",
    "prosemirror-view": "^1.42.6"
  }
}
