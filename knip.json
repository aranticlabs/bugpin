{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignoreDependencies": ["@aws-sdk/client-s3"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "unlisted": "off"
  },
  "workspaces": {
    ".": {
      "project": ["**/*.{ts,tsx,js,jsx}", "!ee/**"],
      "entry": ["tests/**/*.test.ts", "tests/fixtures/*.ts", "tests/e2e/**/*.ts"]
    },
    "src/server": {
      "entry": ["scripts/*.ts"]
    },
    "src/portal": {
      "entry": ["tests/**/*.test.{ts,tsx}"]
    }
  }
}
